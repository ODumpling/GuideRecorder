{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "toolbar",
  "description": "The floating recording toolbar: recording events, dragging and sizing the window, pause, resume, stop and manual steps, and the live capture feed (thumbnails, rename, delete)",
  "windows": [
    "toolbar"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-recording-status",
    "allow-pause-recording",
    "allow-resume-recording",
    "allow-stop-recording",
    "allow-add-manual-step",
    "allow-recording-snapshot",
    "allow-delete-capture",
    "allow-rename-capture",
    "allow-resize-toolbar",
    "allow-set-toolbar-typing"
  ]
}
