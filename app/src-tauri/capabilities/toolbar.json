{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "toolbar",
  "description": "The floating recording toolbar: recording events, dragging the window, and pause, resume, stop and manual steps",
  "windows": [
    "toolbar"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-recording-status",
    "allow-pause-recording",
    "allow-resume-recording",
    "allow-stop-recording",
    "allow-add-manual-step"
  ]
}
