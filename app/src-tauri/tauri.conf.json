{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GuideRecorder",
  "version": "0.2.0",
  "identifier": "dev.dufflebear.guiderecorder",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "GuideRecorder",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-lkJefMmXPFf8vylDs1iPMD3MfHff730es08FaHj3SLY=' 'sha256-UJ+Qv/TXxypRyWyd+8GC0lt+tZ9PvKo8tpDy+tT9TK8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "GuideRecorder Local Dev",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.3"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyNzY4QUY3Mjg4MDBDMzkKUldRNURJQW85NHAySWw5STdXUkw0dXNNZFdya2JSNGxoeldFMzhGTjFYWGJQbWtVZkMrR3ExeHcK",
      "endpoints": [
        "https://github.com/ODumpling/GuideRecorder/releases/latest/download/latest.json"
      ]
    }
  }
}
