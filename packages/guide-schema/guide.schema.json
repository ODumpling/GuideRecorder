{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guide",
  "description": "A whole guide: the contents of `guide.json`.",
  "type": "object",
  "properties": {
    "aiState": {
      "description": "Provenance of the guide-level fields (`title`, `intro`,\n`prerequisites`, `summary`, `tags`). The editor sets `edited` when the\nuser changes any of them, and keeps it while any is in\n[`Guide::edited_fields`].",
      "$ref": "#/$defs/AiState"
    },
    "audience": {
      "$ref": "#/$defs/Audience",
      "default": "beginner"
    },
    "coverOptions": {
      "description": "How the cover is drawn; left out while default.",
      "$ref": "#/$defs/CoverOptions"
    },
    "coverStepId": {
      "description": "The step the author chose as the cover: the guide's library card,\nthe cover page of a PDF or Word export and an HTML export's\n`og:image`. Unset, or naming a step that is gone or has no\nscreenshot, the card shows the first screenshot and exports show no\ncover image (see [`Guide::cover_step`]).",
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "editedFields": {
      "description": "The guide-level fields the user wrote by hand; the AI guide pass\nleaves them alone and may still write the others. Empty in guides\nsaved before it existed: there an `edited` [`Guide::ai_state`] means\nevery field is the user's (see [`Guide::is_field_edited`]).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/GuideField"
      }
    },
    "id": {
      "type": "string"
    },
    "intro": {
      "description": "Markdown.",
      "type": "string",
      "default": ""
    },
    "items": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Item"
      }
    },
    "kind": {
      "description": "What the guide is: recorded steps, or uploaded pages with hotspots.",
      "$ref": "#/$defs/GuideKind"
    },
    "language": {
      "description": "BCP 47 language tag of the guide text, e.g. `en`.",
      "type": "string"
    },
    "lastReviewed": {
      "description": "The day the guide was last reviewed, `YYYY-MM-DD`.",
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "owner": {
      "description": "Who keeps the guide current, as free text.",
      "type": [
        "string",
        "null"
      ]
    },
    "prerequisites": {
      "description": "Markdown.",
      "type": "string",
      "default": ""
    },
    "recording": {
      "description": "Absent for guides built by hand rather than recorded.",
      "anyOf": [
        {
          "$ref": "#/$defs/RecordingInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewIntervalMonths": {
      "description": "Review every N months; unset or 0: no schedule.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/GuideStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "default": ""
    },
    "tags": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "description": "Free text, e.g. `1.2`.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "language",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "AiState": {
      "type": "object",
      "properties": {
        "error": {
          "description": "Short message from the last failed AI pass; cleared when a later\npass succeeds. The text and `status` are left as they were.",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "description": "Model that produced the current text.",
          "type": [
            "string",
            "null"
          ]
        },
        "promptVersion": {
          "description": "Prompt file version, e.g. `step.v1`.",
          "type": [
            "string",
            "null"
          ]
        },
        "redactionSuggestions": {
          "description": "Blur regions suggested for the step's screenshot, by the AI or found\non the device ([`crate::redact`]). Suggestions only (Q9): never\napplied as annotations without the user. Each successful per-step AI\npass replaces the AI's own; on-device ones stay until reviewed.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RedactionSuggestion"
          }
        },
        "scanned": {
          "description": "Whether the step's screenshot was scanned for sensitive text on this\ndevice ([`crate::redact`]), so the editor can say which steps were\nnot.",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/AiStatus",
          "default": "template"
        }
      }
    },
    "AiStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "generating"
          ]
        },
        {
          "description": "Template text only; no AI pass yet.",
          "type": "string",
          "const": "template"
        },
        {
          "description": "Text from the AI pass.",
          "type": "string",
          "const": "ai"
        },
        {
          "description": "Edited by the user; never overwritten by AI.",
          "type": "string",
          "const": "edited"
        }
      ]
    },
    "Annotation": {
      "description": "An SVG-compatible overlay shape; never baked into source images.\n\nSerializes as `{ id, type, geometry, style }`.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/AnnotationStyle",
          "default": {}
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "geometry": {
              "$ref": "#/$defs/ArrowGeometry"
            },
            "type": {
              "type": "string",
              "const": "arrow"
            }
          },
          "required": [
            "type",
            "geometry"
          ]
        },
        {
          "type": "object",
          "properties": {
            "geometry": {
              "$ref": "#/$defs/Rect"
            },
            "type": {
              "type": "string",
              "const": "box"
            }
          },
          "required": [
            "type",
            "geometry"
          ]
        },
        {
          "type": "object",
          "properties": {
            "geometry": {
              "$ref": "#/$defs/Rect"
            },
            "type": {
              "type": "string",
              "const": "highlight"
            }
          },
          "required": [
            "type",
            "geometry"
          ]
        },
        {
          "type": "object",
          "properties": {
            "geometry": {
              "$ref": "#/$defs/CalloutGeometry"
            },
            "type": {
              "type": "string",
              "const": "callout"
            }
          },
          "required": [
            "type",
            "geometry"
          ]
        },
        {
          "type": "object",
          "properties": {
            "geometry": {
              "$ref": "#/$defs/Rect"
            },
            "type": {
              "type": "string",
              "const": "blur"
            }
          },
          "required": [
            "type",
            "geometry"
          ]
        },
        {
          "type": "object",
          "properties": {
            "geometry": {
              "$ref": "#/$defs/Rect"
            },
            "type": {
              "type": "string",
              "const": "crop"
            }
          },
          "required": [
            "type",
            "geometry"
          ]
        },
        {
          "type": "object",
          "properties": {
            "geometry": {
              "$ref": "#/$defs/HotspotGeometry"
            },
            "type": {
              "type": "string",
              "const": "hotspot"
            }
          },
          "required": [
            "type",
            "geometry"
          ]
        }
      ],
      "required": [
        "id"
      ]
    },
    "AnnotationStyle": {
      "description": "Visual style; unset fields use the app's defaults.",
      "type": "object",
      "properties": {
        "blurAmount": {
          "description": "Blur radius or pixel block size, in image pixels.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "blurMode": {
          "description": "Blur annotations only.",
          "anyOf": [
            {
              "$ref": "#/$defs/BlurMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "description": "CSS colour, e.g. `#ff3b30`.",
          "type": [
            "string",
            "null"
          ]
        },
        "fill": {
          "type": [
            "string",
            "null"
          ]
        },
        "fontSize": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "opacity": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "strokeWidth": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "AppInfo": {
      "type": "object",
      "properties": {
        "bundleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "ArrowGeometry": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/Point"
        },
        "to": {
          "$ref": "#/$defs/Point"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "Audience": {
      "type": "string",
      "enum": [
        "beginner",
        "expert"
      ]
    },
    "BlurMode": {
      "type": "string",
      "enum": [
        "blur",
        "pixelate"
      ]
    },
    "BranchTarget": {
      "description": "Where a [`DecisionOption`] leads. Tagged by `kind`. A step or section\nthat is gone (or left out for an audience) reads as `next`.",
      "oneOf": [
        {
          "description": "Carry on with the item after the decision.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "next"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "A step of this guide.",
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "step"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "description": "A section of this guide: its first step.",
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "section"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "description": "Another guide of the library. `title` is its title when the option\nwas set, shown by exports, which cannot look it up.",
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "guide"
            },
            "title": {
              "type": "string",
              "default": ""
            }
          },
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "CalloutGeometry": {
      "type": "object",
      "properties": {
        "anchor": {
          "description": "Point the callout's pointer targets, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ]
        },
        "height": {
          "type": "number",
          "format": "double"
        },
        "text": {
          "description": "Plain text.",
          "type": "string"
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height",
        "text"
      ]
    },
    "CoverOptions": {
      "description": "How a guide's cover is drawn from its step ([`Guide::cover_step_id`]).\nBlur and pixelation are burned in either way, and a crop annotation\nstill cuts the view.",
      "type": "object",
      "properties": {
        "annotations": {
          "description": "Draw the step's annotations (arrows, boxes, callouts, hotspots) on\nit; off by default.",
          "type": "boolean",
          "default": false
        },
        "image": {
          "description": "The close-up (`crop`) or the full screenshot (`full`, the default).\nA step without a close-up shows its full screenshot.",
          "$ref": "#/$defs/ImageShow",
          "default": "full"
        }
      }
    },
    "Decision": {
      "description": "A question the reader answers to choose where to go next, e.g. \"Do you\nsee the sign-in dialog?\". Static exports list the options with \"go to\nstep N\"; the interactive walkthrough follows them.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DecisionOption"
          }
        },
        "question": {
          "description": "Markdown.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "question"
      ]
    },
    "DecisionOption": {
      "description": "One answer of a [`Decision`] and where it leads.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "description": "Plain text, e.g. `Yes`.",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/BranchTarget",
          "default": {
            "kind": "next"
          }
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "DisplayInfo": {
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "scale": {
          "description": "Backing scale factor (physical / logical pixels).",
          "type": "number",
          "format": "double"
        },
        "width": {
          "description": "Size in physical pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "width",
        "height",
        "scale"
      ]
    },
    "ElementInfo": {
      "description": "Accessibility info for the element a step acted on.",
      "type": "object",
      "properties": {
        "app": {
          "type": [
            "string",
            "null"
          ]
        },
        "bundleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "GuideField": {
      "description": "A guide-level field the AI guide pass writes.",
      "type": "string",
      "enum": [
        "title",
        "intro",
        "prerequisites",
        "summary",
        "tags"
      ]
    },
    "GuideKind": {
      "description": "What a guide is made of.",
      "oneOf": [
        {
          "description": "Recorded (or hand-made) steps.",
          "type": "string",
          "const": "walkthrough"
        },
        {
          "description": "Uploaded pages (images, PDF pages), each a `manual` step showing its\nfull image, explained by [`Shape::Hotspot`] annotations.",
          "type": "string",
          "const": "annotated"
        }
      ]
    },
    "GuideStatus": {
      "description": "Where a guide stands in its review cycle.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "draft",
            "inReview",
            "published"
          ]
        },
        {
          "description": "Known to be out of date.",
          "type": "string",
          "const": "needsUpdate"
        }
      ]
    },
    "HotspotGeometry": {
      "description": "A region the reader can hover or click to see its title and\ndescription. Numbered 1, 2, 3, ... in annotation order among the step's\nhotspots.",
      "type": "object",
      "properties": {
        "description": {
          "description": "Plain text; may hold line breaks.",
          "type": "string",
          "default": ""
        },
        "height": {
          "type": "number",
          "format": "double"
        },
        "title": {
          "description": "Plain text.",
          "type": "string",
          "default": ""
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "ImageShow": {
      "description": "Which image the step displays.",
      "type": "string",
      "enum": [
        "crop",
        "full"
      ]
    },
    "Item": {
      "description": "One entry of [`Guide::items`], tagged by `type`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "step"
            }
          },
          "$ref": "#/$defs/Step",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "section"
            }
          },
          "$ref": "#/$defs/Section",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "note"
            }
          },
          "$ref": "#/$defs/Note",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "decision"
            }
          },
          "$ref": "#/$defs/Decision",
          "required": [
            "type"
          ]
        }
      ]
    },
    "Note": {
      "type": "object",
      "properties": {
        "body": {
          "description": "Markdown.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NoteKind"
        }
      },
      "required": [
        "id",
        "kind",
        "body"
      ]
    },
    "NoteKind": {
      "type": "string",
      "enum": [
        "tip",
        "warning",
        "note"
      ]
    },
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "RecordedArea": {
      "description": "The capture area of a recording ([`RecordingInfo::capture_area`]).\nTagged by `kind`.",
      "oneOf": [
        {
          "description": "One display, or every display when `displayId` is absent.",
          "type": "object",
          "properties": {
            "displayId": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "display"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "One window. Window ids do not outlive the window, so it is found\nagain by its app and title.",
          "type": "object",
          "properties": {
            "app": {
              "type": "string"
            },
            "bundleId": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "window"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "app"
          ]
        },
        {
          "description": "A region of a display, in global display points.",
          "type": "object",
          "properties": {
            "displayId": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "region"
            },
            "rect": {
              "$ref": "#/$defs/Rect"
            }
          },
          "required": [
            "kind",
            "rect"
          ]
        }
      ]
    },
    "RecordingInfo": {
      "description": "Environment the guide was recorded in.",
      "type": "object",
      "properties": {
        "appVersion": {
          "description": "GuideRecorder version that made the recording.",
          "type": "string"
        },
        "apps": {
          "description": "Applications seen during the recording.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AppInfo"
          }
        },
        "captureArea": {
          "description": "What the recording captured, so a re-capture of a step (or steps\nrecorded into the guide later) can capture the same. Absent in\nguides recorded before it was kept.",
          "anyOf": [
            {
              "$ref": "#/$defs/RecordedArea"
            },
            {
              "type": "null"
            }
          ]
        },
        "displays": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DisplayInfo"
          }
        },
        "osVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "appVersion"
      ]
    },
    "Rect": {
      "type": "object",
      "properties": {
        "height": {
          "type": "number",
          "format": "double"
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "RedactionSuggestion": {
      "description": "A suggested blur region.",
      "type": "object",
      "properties": {
        "preview": {
          "description": "A masked hint of the text found, e.g. `•••• 4417`, for the editor's\nprivacy review. Only as much as is safe to keep in `guide.json`\n(which syncs): never the text itself. Absent for the AI's and for\nkinds with nothing safe to show.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why it looks sensitive, e.g. `email address`.",
          "type": "string"
        },
        "rect": {
          "description": "In full-screenshot pixels.",
          "$ref": "#/$defs/Rect"
        },
        "review": {
          "description": "What the user decided. Absent: not reviewed yet (pending), the only\nstate blurred into images that leave the device.",
          "anyOf": [
            {
              "$ref": "#/$defs/SuggestionReview"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "description": "Who suggested it. Absent (the AI) in guides saved before on-device\nredaction.",
          "$ref": "#/$defs/SuggestionSource"
        }
      },
      "required": [
        "rect",
        "reason"
      ]
    },
    "Section": {
      "type": "object",
      "properties": {
        "audiences": {
          "description": "Who the section is for, e.g. `Admin`, as free text. Empty: everyone.\nAn export for one audience leaves out the sections tagged only for\nothers (see [`crate::branch::for_audience`]). Left out while empty.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "Step": {
      "type": "object",
      "properties": {
        "aiState": {
          "$ref": "#/$defs/AiState",
          "default": {
            "status": "template"
          }
        },
        "annotations": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Annotation"
          }
        },
        "description": {
          "description": "Markdown.",
          "type": "string",
          "default": ""
        },
        "element": {
          "anyOf": [
            {
              "$ref": "#/$defs/ElementInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "endPoint": {
          "description": "Where a `drag` step ends, in full-screenshot pixels; `point` is its start.",
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/StepImage"
        },
        "keystrokes": {
          "description": "Keystrokes with secure-field input already masked.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/StepKind"
        },
        "narration": {
          "description": "What the author said during the step while narrating a recording,\ntranscribed on the device (see [`crate::narration`]). Plain text,\nkept as spoken: it fills an empty description and is context for\nthe AI step and guide passes. Left out while empty.",
          "type": "string"
        },
        "point": {
          "description": "Interaction point in full-screenshot pixels.",
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "description": "Markdown.",
          "type": "string"
        },
        "url": {
          "description": "Web address of the page the step was on, when it was recorded in a\nbrowser (see [`crate::web`]): an http or https URL. Absent for other\napps, private windows and guides recorded before it was kept.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "image"
      ]
    },
    "StepImage": {
      "description": "Bundle-relative image paths for a step.",
      "type": "object",
      "properties": {
        "after": {
          "description": "Optional frame captured after the action.",
          "type": [
            "string",
            "null"
          ]
        },
        "crop": {
          "description": "Click crop, e.g. `steps/<id>.crop.webp`. Absent for manual steps\ninserted from an image file.",
          "type": [
            "string",
            "null"
          ]
        },
        "cropRect": {
          "description": "Where the crop sits inside the full screenshot, in full-screenshot\npixels. Annotation geometry is in full-screenshot pixels, so this is\nwhat maps it into the crop. Absent for older guides or no crop.",
          "anyOf": [
            {
              "$ref": "#/$defs/Rect"
            },
            {
              "type": "null"
            }
          ]
        },
        "full": {
          "description": "Full screenshot, e.g. `steps/<id>.webp`.",
          "type": "string"
        },
        "show": {
          "$ref": "#/$defs/ImageShow",
          "default": "crop"
        }
      },
      "required": [
        "full"
      ]
    },
    "StepKind": {
      "type": "string",
      "enum": [
        "click",
        "doubleClick",
        "rightClick",
        "type",
        "shortcut",
        "drag",
        "manual"
      ]
    },
    "SuggestionReview": {
      "description": "The user's decision on a [`RedactionSuggestion`].",
      "oneOf": [
        {
          "description": "Accepted: a blur annotation now covers it.",
          "type": "string",
          "const": "blurred"
        },
        {
          "description": "Left as it is.",
          "type": "string",
          "const": "kept"
        }
      ]
    },
    "SuggestionSource": {
      "description": "Where a [`RedactionSuggestion`] came from.",
      "oneOf": [
        {
          "description": "The AI step pass.",
          "type": "string",
          "const": "ai"
        },
        {
          "description": "Text recognised and matched on this device ([`crate::redact`]).",
          "type": "string",
          "const": "onDevice"
        }
      ]
    }
  }
}
