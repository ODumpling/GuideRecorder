<!doctype html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="GuidesYa">
<title>{{ title }}</title>
<style>
{{ css }}</style>
</head>
<body>
<main class="guide">
<header class="guide-header">
{%- if logo %}
<img class="logo" src="{{ logo }}" alt="">
{%- endif %}
<h1>{{ title }}</h1>
{%- if summary %}
<p class="summary">{{ summary }}</p>
{%- endif %}
</header>
{%- if intro %}
<section class="intro">
{{ intro }}
</section>
{%- endif %}
{%- if prerequisites %}
<section class="prerequisites">
<h2>{{ labels.prerequisites }}</h2>
{{ prerequisites }}
</section>
{%- endif %}
{%- for item in items %}
{%- if item.kind == "section" %}
<h2 class="section">{{ item.title }}</h2>
{%- elif item.kind == "note" %}
<aside class="note note-{{ item.note_kind }}" role="note">
<p class="note-label">{{ item.label }}</p>
{{ item.body }}
</aside>
{%- else %}
<article class="step" id="step-{{ item.number }}">
<h{{ step_level }} class="step-title"><span class="step-number" aria-label="{{ labels.step }} {{ item.number }}">{{ item.number }}</span><span class="step-text">{{ item.title }}</span></h{{ step_level }}>
<figure class="step-image">
<img src="{{ item.image.src }}" width="{{ item.image.width }}" height="{{ item.image.height }}" alt="{{ item.image.alt }}">
</figure>
{%- if item.description %}
<div class="step-description">
{{ item.description }}
</div>
{%- endif %}
</article>
{%- endif %}
{%- endfor %}
</main>
</body>
</html>
