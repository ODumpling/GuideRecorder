<!doctype html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="GuideRecorder">
<title>{{ title }}</title>
<style>
{{ css }}</style>
</head>
<body>
<main class="guide">
<header class="guide-header">
{%- if logo %}
<img class="logo" src="{{ logo }}" alt="">
{%- endif %}
<h1>{{ title }}</h1>
{%- if summary %}
<p class="summary">{{ summary }}</p>
{%- endif %}
</header>
{%- if intro %}
<section class="intro">
{{ intro }}
</section>
{%- endif %}
{%- if prerequisites %}
<section class="prerequisites">
<h2>{{ labels.prerequisites }}</h2>
{{ prerequisites }}
</section>
{%- endif %}
{%- for item in items %}
{%- if item.kind == "section" %}
<h2 class="section">{{ item.title }}</h2>
{%- elif item.kind == "note" %}
<aside class="note note-{{ item.note_kind }}" role="note">
<p class="note-label">{{ item.label }}</p>
{{ item.body }}
</aside>
{%- else %}
<article class="step" id="step-{{ item.number }}">
<h{{ step_level }} class="step-title"><span class="step-number" aria-label="{{ labels.step }} {{ item.number }}">{{ item.number }}</span><span class="step-text">{{ item.title }}</span></h{{ step_level }}>
<figure class="step-image">
{%- if item.hotspots %}
<div class="hotspot-frame">
<img src="{{ item.image.src }}" width="{{ item.image.width }}" height="{{ item.image.height }}" alt="{{ item.image.alt }}">
{%- for h in item.hotspots %}
{%- if h.style %}
<div class="hotspot {{ h.class }}" style="{{ h.style }}" tabindex="0" role="button" aria-label="{{ h.label }}"{% if h.description %} aria-describedby="{{ h.id }}-text"{% endif %}><span class="hotspot-badge" aria-hidden="true">{{ h.number }}</span><span class="hotspot-popover" role="tooltip">{% if h.title %}<strong>{{ h.title }}</strong>{% endif %}{% if h.description %}<span class="hotspot-text" id="{{ h.id }}-text">{{ h.description }}</span>{% endif %}</span></div>
{%- endif %}
{%- endfor %}
</div>
{%- else %}
<img src="{{ item.image.src }}" width="{{ item.image.width }}" height="{{ item.image.height }}" alt="{{ item.image.alt }}">
{%- endif %}
</figure>
{%- if item.hotspots %}
<ol class="hotspot-legend">
{%- for h in item.hotspots %}
<li id="{{ h.id }}"{% if h.legend_style %} style="{{ h.legend_style }}"{% endif %}><span class="hotspot-number">{{ h.number }}</span><span class="hotspot-entry">{% if h.title %}<strong>{{ h.title }}</strong>{% endif %}{% if h.description %}<span class="hotspot-text">{{ h.description }}</span>{% endif %}</span></li>
{%- endfor %}
</ol>
{%- endif %}
{%- if item.description %}
<div class="step-description">
{{ item.description }}
</div>
{%- endif %}
</article>
{%- endif %}
{%- endfor %}
</main>
</body>
</html>
