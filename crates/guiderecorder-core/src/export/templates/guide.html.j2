<!doctype html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="GuideRecorder">
{%- if og_image %}
<meta property="og:image" content="{{ og_image }}">
{%- endif %}
<title>{{ title }}</title>
<style>
{{ css }}</style>
</head>
<body>
{%- macro decision(item) %}
<aside class="decision" role="group" aria-label="{{ item.label }}">
<p class="decision-question"><span class="decision-label">{{ item.label }}:</span> {{ item.question }}</p>
{%- if item.options %}
<ul class="decision-options">
{%- for option in item.options %}
<li>{% if option.label %}<strong>{{ option.label }}:</strong> {% endif %}{% if option.href %}<a href="{{ option.href }}">{{ option.text }}</a>{% else %}{{ option.text }}{% endif %}</li>
{%- endfor %}
</ul>
{%- endif %}
</aside>
{%- endmacro %}
<main class="guide{% if layout %} {{ layout }}{% endif %}">
{%- if page_header %}
<p class="page-header">{{ page_header }}</p>
{%- endif %}
<header class="guide-header">
{%- if logo %}
<img class="logo" src="{{ logo }}" alt="">
{%- endif %}
<h1>{{ title }}</h1>
{%- if summary %}
<p class="summary">{{ summary }}</p>
{%- endif %}
{%- if details %}
<p class="details">{{ details }}</p>
{%- endif %}
{%- if cover %}
<p class="cover-fields">{{ cover }}</p>
{%- endif %}
</header>
{%- if intro %}
<section class="intro">
{{ intro }}
</section>
{%- endif %}
{%- if prerequisites %}
<section class="prerequisites">
<h2>{{ labels.prerequisites }}</h2>
{{ prerequisites }}
</section>
{%- endif %}
{%- if contents %}
<nav class="contents" aria-label="{{ labels.contents }}">
<h2>{{ labels.contents }}</h2>
<ol>
{%- for chapter in contents %}
<li><a href="#chapter-{{ chapter.number }}">{{ chapter.title }}</a></li>
{%- endfor %}
</ol>
</nav>
{%- endif %}
{%- for item in items %}
{%- if item.kind == "chapter" %}
<h2 class="chapter{% if item.page_break %} page-break{% endif %}" id="chapter-{{ item.number }}">{{ item.title }}</h2>
{%- if item.summary %}
<p class="chapter-summary">{{ item.summary }}</p>
{%- endif %}
{%- if item.intro %}
<section class="intro">
{{ item.intro }}
</section>
{%- endif %}
{%- if item.prerequisites %}
<section class="prerequisites">
<h3>{{ labels.prerequisites }}</h3>
{{ item.prerequisites }}
</section>
{%- endif %}
{%- elif item.kind == "text" %}
<div class="text{% if item.page_break %} page-break{% endif %}">
{{ item.body }}
</div>
{%- elif item.kind == "section" %}
<h{{ section_level }} class="section">{{ item.title }}</h{{ section_level }}>
{%- if item.audiences %}
<p class="audience">{{ item.audiences }}</p>
{%- endif %}
{%- elif item.kind == "decision" %}
{{- decision(item) }}
{%- elif item.kind == "note" %}
<aside class="note note-{{ item.note_kind }}" role="note">
<p class="note-label">{{ item.label }}</p>
{{ item.body }}
</aside>
{%- else %}
<article class="step" id="step-{{ item.anchor }}">
<h{{ step_level }} class="step-title">{% if checklist %}<input class="step-check" type="checkbox" aria-label="{{ labels.step }} {{ item.number }}">{% endif %}<span class="step-number" aria-label="{{ labels.step }} {{ item.number }}">{{ item.number }}</span><span class="step-text">{{ item.title }}</span></h{{ step_level }}>{%- if item.image %}
<figure class="step-image">
{%- if item.hotspots %}
<div class="hotspot-frame">
<img src="{{ item.image.src }}" width="{{ item.image.width }}" height="{{ item.image.height }}" alt="{{ item.image.alt }}">
{%- for h in item.hotspots %}
{%- if h.style %}
<div class="hotspot {{ h.class }}" style="{{ h.style }}" tabindex="0" role="button" aria-label="{{ h.label }}"{% if h.description %} aria-describedby="{{ h.id }}-text"{% endif %}><span class="hotspot-badge" aria-hidden="true">{{ h.number }}</span><span class="hotspot-popover" role="tooltip">{% if h.title %}<strong>{{ h.title }}</strong>{% endif %}{% if h.description %}<span class="hotspot-text" id="{{ h.id }}-text">{{ h.description }}</span>{% endif %}</span></div>
{%- endif %}
{%- endfor %}
</div>
{%- else %}
<img src="{{ item.image.src }}" width="{{ item.image.width }}" height="{{ item.image.height }}" alt="{{ item.image.alt }}">
{%- endif %}
</figure>
{%- endif %}
{%- if item.hotspots %}
<ol class="hotspot-legend">
{%- for h in item.hotspots %}
<li id="{{ h.id }}"{% if h.legend_style %} style="{{ h.legend_style }}"{% endif %}><span class="hotspot-number">{{ h.number }}</span><span class="hotspot-entry">{% if h.title %}<strong>{{ h.title }}</strong>{% endif %}{% if h.description %}<span class="hotspot-text">{{ h.description }}</span>{% endif %}</span></li>
{%- endfor %}
</ol>
{%- endif %}
{%- if item.description %}
<div class="step-description">
{{ item.description }}
</div>
{%- endif %}
</article>
{%- endif %}
{%- endfor %}
{%- if page_footer %}
<footer class="page-footer">{{ page_footer }}</footer>
{%- endif %}
</main>
</body>
</html>
