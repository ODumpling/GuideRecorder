/* Interactive walkthrough, over the document stylesheet. Without script
   (no .wt-js), every slide shows and the controls are hidden. */
.wt { max-width: 76rem; }
.wt-layout { display: grid; grid-template-columns: minmax(0, 1fr) 16rem; gap: 1.5rem; align-items: start; }
.wt-main { min-width: 0; }
.wt-progress, .wt-controls, .wt-hint, .wt-actions { display: none; }
.wt-js .wt-progress { display: block; height: 6px; margin: 0 0 1rem; background: var(--border); border-radius: 3px; overflow: hidden; }
.wt-progress-bar { width: 0; height: 100%; background: var(--accent); transition: width .25s ease; }
.wt-js .wt-controls { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin: 0 0 .5rem; }
.wt-js .wt-hint { display: block; margin: 0 0 1rem; color: var(--muted); font-size: .9rem; }
.wt-js .wt-actions { display: block; margin: 1rem 0 0; }
.wt-status { flex: 1 1 12rem; margin: 0; font-weight: 600; overflow-wrap: anywhere; }
.wt-button {
  font: inherit;
  padding: .45rem .9rem;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--card);
  color: var(--text);
  cursor: pointer;
}
.wt-button:hover { border-color: var(--accent); }
.wt-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
.wt-button[aria-disabled="true"] { opacity: .45; cursor: default; }
.wt-button:focus-visible, .wt-list a:focus-visible, .wt-target:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
.wt-heading:focus { outline: none; }
.wt-slide {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 1.25rem;
  margin: 0 0 1.25rem;
}
.wt-slide[hidden] { display: none; }
.wt-slide > h2 { margin-top: 0; }
.wt-slide .note { border: 1px solid var(--border); border-left: 4px solid var(--note); }
.wt-slide .note-tip { border-left-color: var(--tip); }
.wt-slide .note-warning { border-left-color: var(--warning); }
.wt-section { margin: 0 0 .35rem; color: var(--muted); font-size: .85rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; overflow-wrap: anywhere; }
.wt-decision > h2 .decision-label { color: var(--accent); }
.wt-options { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: .5rem; }
.wt-option { display: flex; flex-wrap: wrap; gap: .5rem; align-items: baseline; text-decoration: none; overflow-wrap: anywhere; }
.wt-option:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
.wt-option-text, .wt-option-static { color: var(--muted); }
.wt-figure .hotspot-frame { display: block; width: fit-content; }
.wt-target {
  position: absolute;
  z-index: 4;
  width: 2.75rem;
  height: 2.75rem;
  margin: -1.375rem 0 0 -1.375rem;
  border: 3px solid var(--accent);
  border-radius: 50%;
  box-shadow: 0 0 0 2px #fff, 0 0 0 4px rgba(0, 0, 0, .25);
  cursor: pointer;
}
.wt-target::before, .wt-target::after { content: ""; position: absolute; border-radius: 50%; }
.wt-target::before { inset: 0; background: var(--accent); opacity: .2; }
.wt-target::after { inset: -3px; border: 3px solid var(--accent); animation: wt-pulse 1.6s ease-out infinite; }
.wt-target:hover::before, .wt-target:focus::before { opacity: .35; }
@keyframes wt-pulse {
  from { transform: scale(1); opacity: .9; }
  to { transform: scale(2.2); opacity: 0; }
}
.wt-nav { position: sticky; top: 1rem; max-height: calc(100vh - 2rem); overflow: auto; }
.wt-list { list-style: none; margin: 0; padding: 0; }
.wt-list-section { margin: .75rem 0 .25rem; padding: 0 .5rem; color: var(--muted); font-size: .8rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; overflow-wrap: anywhere; }
.wt-list a { display: flex; gap: .5rem; padding: .3rem .5rem; border-radius: 6px; color: var(--text); text-decoration: none; line-height: 1.4; }
.wt-list a:hover { background: var(--code-bg); }
.wt-list a[aria-current] { background: var(--accent); color: #fff; }
.wt-list-number { flex: none; min-width: 1.25rem; font-variant-numeric: tabular-nums; opacity: .75; }
.wt-list-text { overflow-wrap: anywhere; }
@media (max-width: 52rem) {
  .wt-layout { grid-template-columns: minmax(0, 1fr); }
  .wt-nav { position: static; max-height: none; }
}
@media (prefers-reduced-motion: reduce) {
  .wt-progress-bar { transition: none; }
  .wt-target::after { animation: none; transform: scale(1.4); opacity: .5; }
}
@media print {
  .wt-layout { display: block; }
  .wt-progress, .wt-controls, .wt-hint, .wt-actions, .wt-nav, .wt-target { display: none !important; }
  .wt-slide[hidden] { display: block; }
}
</style>
</head>
<body>
<main class="guide wt" id="wt">
<header class="guide-header">
<h1>Office floor plan</h1>
<p class="summary">Find your way around the third floor.</p>
</header>
<div class="wt-layout">
<div class="wt-main">
<div class="wt-progress" aria-hidden="true"><div class="wt-progress-bar" id="wt-bar"></div></div>
<div class="wt-controls">
<button type="button" class="wt-button" data-back><span aria-hidden="true">← </span>Back</button>
<p class="wt-status" id="wt-status" role="status" aria-live="polite" aria-atomic="true"></p>
<button type="button" class="wt-button wt-primary" data-next>Next<span aria-hidden="true"> →</span></button>
<button type="button" class="wt-button" data-restart>Restart</button>
</div>
<p class="wt-hint">Click the highlighted spot, or press → or Enter, to continue; ← goes back.</p>
<section class="wt-slide wt-intro" id="wt-slide-0" aria-labelledby="wt-slide-0-title" data-status="Before you start">
<h2 class="wt-heading" id="wt-slide-0-title" tabindex="-1">Before you start</h2>
<div class="intro">
<p>Hover over or tap a numbered area to see what is there.</p>
</div>
<p class="wt-actions"><button type="button" class="wt-button wt-primary" data-next>Start<span aria-hidden="true"> →</span></button></p>
</section>
<section class="wt-slide wt-step" id="wt-slide-1" aria-labelledby="wt-slide-1-title" data-status="Page 1 of 2: Third floor">
<h2 class="step-title wt-heading" id="wt-slide-1-title" tabindex="-1"><span class="step-number" aria-label="Page 1">1</span><span class="step-text">Third floor</span></h2>
<figure class="step-image wt-figure">
<div class="hotspot-frame">
<img src="data:image/png;base64,…" width="480" height="300" alt="Third floor">
<div class="hotspot hotspot-below hotspot-start" style="left:5%;top:8%;width:29.167%;height:30.667%" tabindex="0" role="button" aria-label="1. Reception" aria-describedby="hotspot-1-1-text"><span class="hotspot-badge" aria-hidden="true">1</span><span class="hotspot-popover" role="tooltip"><strong>Reception</strong><span class="hotspot-text" id="hotspot-1-1-text">Sign in here when you arrive.<br>Visitor badges are in the top drawer.</span></span></div>
<div class="hotspot hotspot-below hotspot-center" style="left:36.667%;top:8%;width:28.333%;height:30.667%" tabindex="0" role="button" aria-label="2. Kitchen &amp; café" aria-describedby="hotspot-1-2-text"><span class="hotspot-badge" aria-hidden="true">2</span><span class="hotspot-popover" role="tooltip"><strong>Kitchen &amp; café</strong><span class="hotspot-text" id="hotspot-1-2-text">Coffee, tea and fruit. Please load the dishwasher before you leave.</span></span></div>
<div class="hotspot hotspot-below hotspot-end" style="left:67.5%;top:8%;width:27.5%;height:44%" tabindex="0" role="button" aria-label="3. Meeting room &quot;Fjord&quot;" aria-describedby="hotspot-1-3-text"><span class="hotspot-badge" aria-hidden="true">3</span><span class="hotspot-popover" role="tooltip"><strong>Meeting room &quot;Fjord&quot;</strong><span class="hotspot-text" id="hotspot-1-3-text">Seats 8. Book it on the panel by the door; to present, press &lt;Input&gt; on the remote.</span></span></div>
<div class="hotspot hotspot-above hotspot-start" style="left:5%;top:58.667%;width:43.333%;height:33.333%" tabindex="0" role="button" aria-label="4. Quiet zone" aria-describedby="hotspot-1-4-text"><span class="hotspot-badge" aria-hidden="true">4</span><span class="hotspot-popover" role="tooltip"><strong>Quiet zone</strong><span class="hotspot-text" id="hotspot-1-4-text">No calls or meetings.</span></span></div>
</div>
</figure>
<ol class="hotspot-legend">
<li id="hotspot-1-1"><span class="hotspot-number">1</span><span class="hotspot-entry"><strong>Reception</strong><span class="hotspot-text">Sign in here when you arrive.<br>Visitor badges are in the top drawer.</span></span></li>
<li id="hotspot-1-2"><span class="hotspot-number">2</span><span class="hotspot-entry"><strong>Kitchen &amp; café</strong><span class="hotspot-text">Coffee, tea and fruit. Please load the dishwasher before you leave.</span></span></li>
<li id="hotspot-1-3"><span class="hotspot-number">3</span><span class="hotspot-entry"><strong>Meeting room &quot;Fjord&quot;</strong><span class="hotspot-text">Seats 8. Book it on the panel by the door; to present, press &lt;Input&gt; on the remote.</span></span></li>
<li id="hotspot-1-4"><span class="hotspot-number">4</span><span class="hotspot-entry"><strong>Quiet zone</strong><span class="hotspot-text">No calls or meetings.</span></span></li>
</ol>
<div class="step-description">
<p>The lifts open onto the corridor in the middle.</p>
</div>
</section>
<section class="wt-slide wt-step" id="wt-slide-2" aria-labelledby="wt-slide-2-title" data-status="Page 2 of 2: Fire exits" data-end>
<h2 class="step-title wt-heading" id="wt-slide-2-title" tabindex="-1"><span class="step-number" aria-label="Page 2">2</span><span class="step-text">Fire exits</span></h2>
<aside class="note note-tip" role="note">
<p class="note-label">Tip</p>
<p>Need a desk for the day? Ask at <strong>Reception</strong>.</p>
</aside>
<figure class="step-image wt-figure">
<div class="hotspot-frame">
<img src="data:image/png;base64,…" width="480" height="300" alt="Fire exits">
<div class="hotspot hotspot-above hotspot-end" style="left:90.833%;top:58.667%;width:5.833%;height:18.667%;--hs:#16a34a" tabindex="0" role="button" aria-label="1. Stairwell B" aria-describedby="hotspot-2-1-text"><span class="hotspot-badge" aria-hidden="true">1</span><span class="hotspot-popover" role="tooltip"><strong>Stairwell B</strong><span class="hotspot-text" id="hotspot-2-1-text">Use the stairs in a fire, never the lifts.</span></span></div>
<div class="hotspot hotspot-above hotspot-start" style="left:3.333%;top:78.667%;width:5.833%;height:16%" tabindex="0" role="button" aria-label="2. Stairwell A" aria-describedby="hotspot-2-2-text"><span class="hotspot-badge" aria-hidden="true">2</span><span class="hotspot-popover" role="tooltip"><strong>Stairwell A</strong><span class="hotspot-text" id="hotspot-2-2-text">Leads to the assembly point in the car park.</span></span></div>
</div>
</figure>
<ol class="hotspot-legend">
<li id="hotspot-2-1" style="--hs:#16a34a"><span class="hotspot-number">1</span><span class="hotspot-entry"><strong>Stairwell B</strong><span class="hotspot-text">Use the stairs in a fire, never the lifts.</span></span></li>
<li id="hotspot-2-2"><span class="hotspot-number">2</span><span class="hotspot-entry"><strong>Stairwell A</strong><span class="hotspot-text">Leads to the assembly point in the car park.</span></span></li>
</ol>
</section>
<section class="wt-slide wt-done" id="wt-slide-3" aria-labelledby="wt-slide-3-title" data-status="Done" data-end>
<h2 class="wt-heading" id="wt-slide-3-title" tabindex="-1">Done</h2>
<p>You have reached the end of this guide.</p>
<p class="wt-actions"><button type="button" class="wt-button wt-primary" data-restart>Restart</button></p>
</section>
</div>
<nav class="wt-nav" aria-label="Steps">
<ol class="wt-list">
<li><a href="#wt-slide-0" data-slide="0"><span class="wt-list-text">Before you start</span></a></li>
<li><a href="#wt-slide-1" data-slide="1"><span class="wt-list-number">1</span><span class="wt-list-text">Third floor</span></a></li>
<li><a href="#wt-slide-2" data-slide="2"><span class="wt-list-number">2</span><span class="wt-list-text">Fire exits</span></a></li>
<li><a href="#wt-slide-3" data-slide="3"><span class="wt-list-text">Done</span></a></li>
</ol>
</nav>
</div>
</main>
<script>(function () {
  "use strict";
  var root = document.getElementById("wt");
  if (!root) return;
  var slides = Array.prototype.slice.call(root.querySelectorAll(".wt-slide"));
  var links = Array.prototype.slice.call(root.querySelectorAll(".wt-list a[data-slide]"));
  var bar = document.getElementById("wt-bar");
  var status = document.getElementById("wt-status");
  var backs = root.querySelectorAll(".wt-controls [data-back]");
  var nexts = root.querySelectorAll(".wt-controls [data-next]");
  var current = 0;
  if (!slides.length) return;
  // The slides moved on from, so Back retraces a branch taken. Kept in
  // the root's data-trail too, where a SCORM runtime saves and restores it.
  var trail = (root.getAttribute("data-trail") || "")
    .split(" ")
    .filter(function (n) {
      return /^\d+$/.test(n) && Number(n) < slides.length;
    })
    .map(Number);
  document.documentElement.classList.add("wt-js");

  function setDisabled(buttons, disabled) {
    for (var i = 0; i < buttons.length; i++) {
      if (disabled) buttons[i].setAttribute("aria-disabled", "true");
      else buttons[i].removeAttribute("aria-disabled");
    }
  }

  // Shows slide `index`. Focus moves to its heading when `focus` is
  // "content", or when it is "keep" and the focused element was hidden
  // with the old slide; "none" leaves it (on load).
  function show(index, focus) {
    index = Math.max(0, Math.min(slides.length - 1, index));
    var active = document.activeElement;
    slides.forEach(function (slide, i) {
      slide.hidden = i !== index;
    });
    links.forEach(function (link) {
      if (Number(link.getAttribute("data-slide")) === index) link.setAttribute("aria-current", "step");
      else link.removeAttribute("aria-current");
    });
    current = index;
    var last = slides.length - 1;
    bar.style.width = (last > 0 ? (index / last) * 100 : 100) + "%";
    setDisabled(backs, index === 0);
    setDisabled(nexts, index === last);
    status.textContent = slides[index].getAttribute("data-status") || "";
    var lost = !active || active === document.body || !active.offsetParent;
    if (focus === "content" || (focus === "keep" && lost)) {
      var heading = slides[index].querySelector(".wt-heading");
      if (heading) heading.focus();
    }
    try {
      history.replaceState(null, "", "#" + slides[index].id);
    } catch (e) {
      // Not allowed here (e.g. a sandboxed frame); the hash only helps reloads.
    }
  }

  function setTrail(next) {
    trail = next;
    root.setAttribute("data-trail", trail.join(" "));
  }

  // Moves on to slide `index`, remembering this one for Back.
  function go(index, focus) {
    if (index === current) return;
    setTrail(trail.concat(current));
    show(index, focus);
  }

  // Follows a decision option to the slide its link names.
  function branch(href) {
    var index = slides.findIndex(function (slide) {
      return "#" + slide.id === href;
    });
    if (index >= 0) go(index, "content");
  }

  // Back along the way taken, else to the slide before.
  function back() {
    var to = trail.length ? trail[trail.length - 1] : current - 1;
    setTrail(trail.slice(0, -1));
    show(to, "keep");
  }

  root.addEventListener("click", function (event) {
    var el = event.target.closest("[data-next], [data-back], [data-restart], [data-branch], a[data-slide]");
    if (!el || !root.contains(el)) return;
    event.preventDefault();
    if (el.getAttribute("aria-disabled") === "true") return;
    if (el.hasAttribute("data-branch")) branch(el.getAttribute("href"));
    else if (el.hasAttribute("data-slide")) go(Number(el.getAttribute("data-slide")), "content");
    else if (el.hasAttribute("data-restart")) {
      setTrail([]);
      show(0, "content");
    } else if (el.hasAttribute("data-back")) back();
    // Back and Next keep focus, so they can be pressed again; a target goes.
    else go(current + 1, "keep");
  });

  document.addEventListener("keydown", function (event) {
    if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    var target = event.target;
    // Enter activates focused controls and hotspots on its own.
    var control = target.closest && target.closest("a, button, input, select, textarea, [role=button], [contenteditable]");
    if (event.key === "ArrowRight" || (event.key === "Enter" && !control)) {
      event.preventDefault();
      if (current < slides.length - 1) go(current + 1, "keep");
    } else if (event.key === "ArrowLeft") {
      event.preventDefault();
      if (current > 0) back();
    }
  });

  var start = slides.findIndex(function (slide) {
    return "#" + slide.id === location.hash;
  });
  show(start < 0 ? 0 : start, "none");
})();
</script>
</body>
</html>
<!-- warnings
-->
