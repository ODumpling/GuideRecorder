<body>
<main class="guide wt" id="wt">
<header class="guide-header">
<h1>Rotate an API key</h1>
<p class="summary">Replace a leaked or expiring API key without downtime.</p>
</header>
<div class="wt-layout">
<div class="wt-main">
<div class="wt-progress" aria-hidden="true"><div class="wt-progress-bar" id="wt-bar"></div></div>
<div class="wt-controls">
<button type="button" class="wt-button" data-back><span aria-hidden="true">← </span>Back</button>
<p class="wt-status" id="wt-status" role="status" aria-live="polite" aria-atomic="true"></p>
<button type="button" class="wt-button wt-primary" data-next>Next<span aria-hidden="true"> →</span></button>
<button type="button" class="wt-button" data-restart>Restart</button>
</div>
<p class="wt-hint">Click the highlighted spot, or press → or Enter, to continue; ← goes back.</p>
<section class="wt-slide wt-intro" id="wt-slide-0" aria-labelledby="wt-slide-0-title" data-status="Before you start">
<h2 class="wt-heading" id="wt-slide-0-title" tabindex="-1">Before you start</h2>
<div class="intro">
<p>Rotate keys every <em>90 days</em>, or right away if one leaks.</p>
</div>
<div class="prerequisites">
<h3>Prerequisites</h3>
<p>Admin access to the console.</p>
</div>
<p class="wt-actions"><button type="button" class="wt-button wt-primary" data-next>Start<span aria-hidden="true"> →</span></button></p>
</section>
<section class="wt-slide wt-step" id="wt-slide-1" aria-labelledby="wt-slide-1-title" data-status="Step 1 of 5: Open Settings → API keys">
<h2 class="step-title wt-heading" id="wt-slide-1-title" tabindex="-1"><span class="step-number" aria-label="Step 1">1</span><span class="step-text">Open <strong>Settings → API keys</strong></span></h2>
<aside class="note note-warning" role="note">
<p class="note-label">Warning</p>
<p>Creating a new key <strong>revokes</strong> the old one immediately. Update these first:</p>
<ol>
<li>The CI secret</li>
<li>Local <code>.env</code> files</li>
</ol>
</aside>
<figure class="step-image wt-figure">
<div class="hotspot-frame">
<img src="data:image/png;base64,…" width="32" height="20" alt="Open Settings → API keys">
</div>
</figure>
</section>
<section class="wt-slide wt-step" id="wt-slide-2" aria-labelledby="wt-slide-2-title" data-status="Step 2 of 5: Enter your password to confirm">
<h2 class="step-title wt-heading" id="wt-slide-2-title" tabindex="-1"><span class="step-number" aria-label="Step 2">2</span><span class="step-text">Enter your password to confirm</span></h2>
<figure class="step-image wt-figure">
<div class="hotspot-frame">
<img src="data:image/png;base64,…" width="64" height="40" alt="Enter your password to confirm">
<a class="wt-target" href="#wt-slide-3" style="left:25%;top:25%" data-next aria-label="Click here to continue"></a>
</div>
</figure>
<div class="step-description">
<p>Password input is masked while recording.</p>
</div>
</section>
<section class="wt-slide wt-step" id="wt-slide-3" aria-labelledby="wt-slide-3-title" data-status="Step 3 of 5: Click Create key and copy the new key">
<h2 class="step-title wt-heading" id="wt-slide-3-title" tabindex="-1"><span class="step-number" aria-label="Step 3">3</span><span class="step-text">Click <strong>Create key</strong> and copy the new key</span></h2>
<figure class="step-image wt-figure">
<div class="hotspot-frame">
<img src="data:image/png;base64,…" width="64" height="20" alt="Click Create key and copy the new key">
</div>
</figure>
<div class="step-description">
<p>The key is shown <strong>once</strong>. Store it in your password manager; see <a href="https://example.com/docs/keys" rel="noopener noreferrer">Managing keys</a>.</p>
</div>
</section>
<section class="wt-slide wt-decision" id="wt-slide-4" aria-labelledby="wt-slide-4-title" data-status="Decision: Is the key used in production?">
<h2 class="wt-heading" id="wt-slide-4-title" tabindex="-1"><span class="decision-label">Decision:</span> Is the key used in <strong>production</strong>?</h2>
<ul class="wt-options">
<li><a class="wt-button wt-option" href="#wt-slide-5" data-branch><strong>Yes</strong> <span class="wt-option-text">Go to Step 4</span></a></li>
<li><a class="wt-button wt-option" href="#wt-slide-6" data-branch><strong>No</strong> <span class="wt-option-text">Go to Step 5</span></a></li>
<li><span class="wt-option-static"><strong>Unsure:</strong> Go to the guide “Find where an API key is used”</span></li>
</ul>
</section>
<section class="wt-slide wt-step" id="wt-slide-5" aria-labelledby="wt-slide-5-title" data-status="Step 4 of 5: Drag the new key to Production">
<h2 class="step-title wt-heading" id="wt-slide-5-title" tabindex="-1"><span class="step-number" aria-label="Step 4">4</span><span class="step-text">Drag the new key to <strong>Production</strong></span></h2>
<figure class="step-image wt-figure">
<div class="hotspot-frame">
<img src="data:image/png;base64,…" width="64" height="40" alt="Drag the new key to Production">
<a class="wt-target" href="#wt-slide-6" style="left:15.625%;top:25%" data-next aria-label="Click here to continue"></a>
</div>
</figure>
</section>
<section class="wt-slide wt-step" id="wt-slide-6" aria-labelledby="wt-slide-6-title" data-status="Step 5 of 5: Check that the key works" data-end>
<h2 class="step-title wt-heading" id="wt-slide-6-title" tabindex="-1"><span class="step-number" aria-label="Step 5">5</span><span class="step-text">Check that the key works</span></h2>
<figure class="step-image wt-figure">
<div class="hotspot-frame">
<img src="data:image/png;base64,…" width="64" height="40" alt="Check that the key works">
</div>
</figure>
<div class="step-description">
<p>Run this in Terminal:</p>
<p><code>curl -H &quot;x-api-key: $KEY&quot; https://api.example.com/v1/ping</code></p>
<p>It should print <em>pong</em>.</p>
</div>
</section>
<section class="wt-slide wt-done" id="wt-slide-7" aria-labelledby="wt-slide-7-title" data-status="Done" data-end>
<h2 class="wt-heading" id="wt-slide-7-title" tabindex="-1">Done</h2>
<p>You have reached the end of this guide.</p>
<p class="wt-actions"><button type="button" class="wt-button wt-primary" data-restart>Restart</button></p>
</section>
</div>
<nav class="wt-nav" aria-label="Steps">
<ol class="wt-list">
<li><a href="#wt-slide-0" data-slide="0"><span class="wt-list-text">Before you start</span></a></li>
<li><a href="#wt-slide-1" data-slide="1"><span class="wt-list-number">1</span><span class="wt-list-text">Open Settings → API keys</span></a></li>
<li><a href="#wt-slide-2" data-slide="2"><span class="wt-list-number">2</span><span class="wt-list-text">Enter your password to confirm</span></a></li>
<li><a href="#wt-slide-3" data-slide="3"><span class="wt-list-number">3</span><span class="wt-list-text">Click Create key and copy the new key</span></a></li>
<li><a href="#wt-slide-4" data-slide="4"><span class="wt-list-text">Is the key used in production?</span></a></li>
<li><a href="#wt-slide-5" data-slide="5"><span class="wt-list-number">4</span><span class="wt-list-text">Drag the new key to Production</span></a></li>
<li><a href="#wt-slide-6" data-slide="6"><span class="wt-list-number">5</span><span class="wt-list-text">Check that the key works</span></a></li>
<li><a href="#wt-slide-7" data-slide="7"><span class="wt-list-text">Done</span></a></li>
</ol>
</nav>
</div>
</main>
<script>(function () {
  "use strict";
  var root = document.getElementById("wt");
  if (!root) return;
  var slides = Array.prototype.slice.call(root.querySelectorAll(".wt-slide"));
  var links = Array.prototype.slice.call(root.querySelectorAll(".wt-list a[data-slide]"));
  var bar = document.getElementById("wt-bar");
  var status = document.getElementById("wt-status");
  var backs = root.querySelectorAll(".wt-controls [data-back]");
  var nexts = root.querySelectorAll(".wt-controls [data-next]");
  var current = 0;
  if (!slides.length) return;
  // The slides moved on from, so Back retraces a branch taken. Kept in
  // the root's data-trail too, where a SCORM runtime saves and restores it.
  var trail = (root.getAttribute("data-trail") || "")
    .split(" ")
    .filter(function (n) {
      return /^\d+$/.test(n) && Number(n) < slides.length;
    })
    .map(Number);
  document.documentElement.classList.add("wt-js");

  function setDisabled(buttons, disabled) {
    for (var i = 0; i < buttons.length; i++) {
      if (disabled) buttons[i].setAttribute("aria-disabled", "true");
      else buttons[i].removeAttribute("aria-disabled");
    }
  }

  // Shows slide `index`. Focus moves to its heading when `focus` is
  // "content", or when it is "keep" and the focused element was hidden
  // with the old slide; "none" leaves it (on load).
  function show(index, focus) {
    index = Math.max(0, Math.min(slides.length - 1, index));
    var active = document.activeElement;
    slides.forEach(function (slide, i) {
      slide.hidden = i !== index;
    });
    links.forEach(function (link) {
      if (Number(link.getAttribute("data-slide")) === index) link.setAttribute("aria-current", "step");
      else link.removeAttribute("aria-current");
    });
    current = index;
    var last = slides.length - 1;
    bar.style.width = (last > 0 ? (index / last) * 100 : 100) + "%";
    setDisabled(backs, index === 0);
    setDisabled(nexts, index === last);
    status.textContent = slides[index].getAttribute("data-status") || "";
    var lost = !active || active === document.body || !active.offsetParent;
    if (focus === "content" || (focus === "keep" && lost)) {
      var heading = slides[index].querySelector(".wt-heading");
      if (heading) heading.focus();
    }
    try {
      history.replaceState(null, "", "#" + slides[index].id);
    } catch (e) {
      // Not allowed here (e.g. a sandboxed frame); the hash only helps reloads.
    }
  }

  function setTrail(next) {
    trail = next;
    root.setAttribute("data-trail", trail.join(" "));
  }

  // Moves on to slide `index`, remembering this one for Back.
  function go(index, focus) {
    if (index === current) return;
    setTrail(trail.concat(current));
    show(index, focus);
  }

  // Follows a decision option to the slide its link names.
  function branch(href) {
    var index = slides.findIndex(function (slide) {
      return "#" + slide.id === href;
    });
    if (index >= 0) go(index, "content");
  }

  // Back along the way taken, else to the slide before.
  function back() {
    var to = trail.length ? trail[trail.length - 1] : current - 1;
    setTrail(trail.slice(0, -1));
    show(to, "keep");
  }

  root.addEventListener("click", function (event) {
    var el = event.target.closest("[data-next], [data-back], [data-restart], [data-branch], a[data-slide]");
    if (!el || !root.contains(el)) return;
    event.preventDefault();
    if (el.getAttribute("aria-disabled") === "true") return;
    if (el.hasAttribute("data-branch")) branch(el.getAttribute("href"));
    else if (el.hasAttribute("data-slide")) go(Number(el.getAttribute("data-slide")), "content");
    else if (el.hasAttribute("data-restart")) {
      setTrail([]);
      show(0, "content");
    } else if (el.hasAttribute("data-back")) back();
    // Back and Next keep focus, so they can be pressed again; a target goes.
    else go(current + 1, "keep");
  });

  document.addEventListener("keydown", function (event) {
    if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    var target = event.target;
    // Enter activates focused controls and hotspots on its own.
    var control = target.closest && target.closest("a, button, input, select, textarea, [role=button], [contenteditable]");
    if (event.key === "ArrowRight" || (event.key === "Enter" && !control)) {
      event.preventDefault();
      if (current < slides.length - 1) go(current + 1, "keep");
    } else if (event.key === "ArrowLeft") {
      event.preventDefault();
      if (current > 0) back();
    }
  });

  var start = slides.findIndex(function (slide) {
    return "#" + slide.id === location.hash;
  });
  show(start < 0 ? 0 : start, "none");
})();
</script>
</body>
</html>
