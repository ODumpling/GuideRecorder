# Copy to .env.local. The defaults match compose.yaml.
DATABASE_URL=postgres://guiderecorder:guiderecorder@localhost:5432/guiderecorder
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# The local development domain; run scripts/dev-domain.sh setup once.
# Without it: http://localhost:3000 (the desktop app's dev build won't reach it).
BETTER_AUTH_URL=https://app.guiderecorder.dev:3000

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=guiderecorder
S3_ACCESS_KEY_ID=guiderecorder
S3_SECRET_ACCESS_KEY=guiderecorder
# Optional: encryption at rest on S3 (AES256 or aws:kms). Leave unset for R2.
S3_SSE=
S3_SSE_KMS_KEY_ID=

# Optional: sign-in providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional: billing. Webhook endpoint: /api/auth/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Optional: email. Without it, emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM=

# Production (docs/web-deployment.md). SCIM token HMAC key (32+ chars;
# derived from BETTER_AUTH_SECRET when unset), the bearer token for
# /api/jobs/retention, and the proxies whose X-Forwarded-For to trust.
SCIM_TOKEN_SECRET=
JOBS_TOKEN=
TRUSTED_PROXIES=

# Comma-separated: users made (if missing) and given the staff console on
# every deploy, by `pnpm staff ensure` after migrations.
STAFF_EMAILS=

# Development only: the email domain of the `pnpm db:seed` accounts
# (hello@ and staff@ are staff). Defaults to dufflebear.dev.
SEED_EMAIL_DOMAIN=
