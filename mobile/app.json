{
  "expo": {
    "name": "GuideRecorder",
    "slug": "guiderecorder",
    "scheme": "guiderecorder",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.guiderecorder.mobile",
      "supportsTablet": true,
      "requireFullScreen": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.guiderecorder.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#18181b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "GuideRecorder uses the camera to take photos for the steps of your guides.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 120,
          "backgroundColor": "#f3f6fa",
          "dark": {
            "backgroundColor": "#161615"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "GuideRecorder opens the screen recordings you choose to turn them into steps.",
          "cameraPermission": "GuideRecorder uses the camera to take photos for the steps of your guides."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
